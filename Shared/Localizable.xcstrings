    "Koco has no access to Photos, so the picture wasn’t saved. Allow it in Settings.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "写真へのアクセスがないため保存されませんでした。設定で許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "사진 접근 권한이 없어 저장하지 못했습니다. 설정에서 허용해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有相册权限，照片未保存。请在系统设置里允许访问照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
