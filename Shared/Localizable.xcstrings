    "One sample from each film · AI originals, film rendered by Koco · tap one to look at that film": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "各フィルムの作例 · 元画像は AI 生成、フィルムの風合いは Koco が描写 · タップでそのフィルムへ"
          }
        },
        "ko": {
