    "“I can’t stop watching my dog sleep. So soothing!”": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「寝てるうちの犬、つい見ちゃう。癒やされる！」"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「잠든 우리 강아지, 자꾸 보게 돼. 너무 힐링!」"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「我总是忍不住看我睡着的狗狗 太治愈！」"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「我總是忍不住看我睡著的狗狗 太療癒！」"
          }
        }
      }
    },
