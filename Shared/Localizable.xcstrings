    "Privacy": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐私"
          }
        }
      }
    },
    "Purchase waiting for approval": {
      "comment": "Shown on a film's page after Ask to Buy or a payment that still has to be confirmed.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
