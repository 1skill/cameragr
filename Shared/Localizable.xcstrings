        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看样张"
          }
        }
      }
    },
    "Samples for this film are on their way.\nTry it on one of your own photos meanwhile.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这卷的样张还在制作中。\n可以先用你自己的照片试试。"
          }
        }
      }
    },
    "Save the iPhone original too": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时保存 iPhone 原图"
          }
        }
      }
    },
    "Send feedback": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "意见反馈"
          }
        }
      }
