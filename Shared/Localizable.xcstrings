            "value": "關於"
          }
        }
      }
    },
    "Access": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アクセス"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "권한"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "权限"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "權限"
          }
        }
      }
    },
    "Add Koco from the Lock Screen’s and Control Center’s controls to start shooting without unlocking.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ロック画面とコントロールセンターのコントロールにKocoを追加すると、ロックを解除せずに撮影を始められます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "잠금 화면과 제어 센터의 제어 항목에 Koco를 추가하면 잠금을 풀지 않고 바로 촬영할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在锁屏和控制中心的控件里添加 Koco，不用解锁就能开拍。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在鎖定畫面和控制中心的控制項裡加入 Koco，不用解鎖就能開拍。"
          }
        }
      }
    },
    "All films": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "すべてのフィルム"
          }
        },
