    "This made my day. Send me one from yours.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "今日はこれに癒やされた。そっちも一枚撮って見せて。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "오늘 이 장면에 힐링했어. 너도 한 장 찍어 보여 줘."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
