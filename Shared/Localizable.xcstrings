    "Koco Camera" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kocoカメラ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Koco 카메라"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koco 相机"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Koco 相機"
          }
        }
      }
    },
    "Koco develops your pictures on your iPhone and saves them to your photo library. Only the pictures you post to the community leave the phone, with your name, the film and your caption; you sign in with Apple to post, and can delete your account at any time." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Koco は写真を iPhone 上で現像し、写真ライブラリに保存します。端末の外に出るのは、コミュニティに投稿した写真と名前・フィルム・キャプションだけです。投稿には Apple でサインインが必要で、アカウントはいつでも削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Koco는 사진을 iPhone에서 현상해 사진 보관함에 저장합니다. 휴대폰 밖으로 나가는 것은 커뮤니티에 올린 사진과 이름, 필름, 설명뿐입니다. 게시하려면 Apple로 로그인해야 하며, 계정은 언제든 삭제할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koco 在你的 iPhone 上冲洗照片并存入相册。只有你投到社区的照片会离开手机，连同你的名字、胶卷和配文；投稿需用 Apple 登录，账号随时可以删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Koco 在你的 iPhone 上沖洗照片並存入相簿。只有你投到社群的照片會離開手機，連同你的名字、底片和說明；投稿需用 Apple 登入，帳號隨時可以刪除。"
          }
        }
      }
    },
    "Koco film certificate" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Koco フィルム証書"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Koco 필름 증서"
          }
        },
        "zh-Hans" : {
