          }
        }
      }
    },
    "Tap a roll to start shooting with it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点一卷胶卷，直接用它开拍。"
          }
        }
      }
    },
    "Tap the film door on the right to open the chamber, then tap the roll to rewind it and pick another.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点右侧的胶卷仓门打开胶卷仓，再点胶卷把它倒回，然后换一卷。"
          }
        }
      }
    },
    "Terms of use": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户协议"
          }
        }
      }
    },
    "That photo couldn't be opened. Try another one.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这张照片打不开，换一张试试。"
          }
        }
      }
    },
    "The Camera Control button": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机控制按钮"
          }
        }
      }
    },
    "The camera is used only to take pictures, and the photo library only to save them and to open pictures you choose to try a film on.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机只用来拍照；相册只用来保存照片，以及打开你选来试胶卷的照片。"
          }
        }
      }
    },
    "The picture couldn’t be developed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片处理失败。"
          }
        }
      }
    },
    "The picture couldn’t be saved to Photos.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存到相册失败。"
