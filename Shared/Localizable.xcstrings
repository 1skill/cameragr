{
  "sourceLanguage": "en",
  "strings": {
    "%@ samples · AI originals, film rendered by Koco": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@の作例 · 元画像はAI生成、フィルムはKocoで描画"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 샘플 · 원본은 AI 생성, 필름은 Koco가 렌더링"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 样张 · 原图由 AI 生成，胶片效果由 Koco 渲染"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 樣張 · 原圖由 AI 生成，底片效果由 Koco 算繪"
          }
        }
      }
    },
    "%@ · %lld": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ · %lld枚"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ · %lld장"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %lld 张"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ · %lld 張"
          }
        }
      }
    },
    "%@ · %lld · %lld/%lld": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ · %lld枚 · %lld/%lld"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ · %lld장 · %lld/%lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %lld 张 · %lld/%lld"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ · %lld 張 · %lld/%lld"
          }
        }
      }
    },
    "%@ — no pictures yet": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ — まだ撮影なし"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ — 아직 찍은 사진 없음"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — 还没拍过"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ — 還沒拍過"
          }
        }
      }
    },
    "%@ — pictures deleted or hidden": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ — 写真が削除されたか見えません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ — 사진이 삭제되었거나 보이지 않음"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — 照片已删除或看不到"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ — 相片已刪除或看不到"
          }
        }
      }
    },
    "%lld free trial shots left": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "無料の試し撮りあと%lld枚"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "무료 체험 촬영 %lld장 남음"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还可免费试拍 %lld 张"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "還可免費試拍 %lld 張"
          }
        }
      }
    },
    "%lld of %lld days. See you tomorrow.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%2$lld日中%1$lld日目。また明日。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%2$lld일 중 %1$lld일째. 내일 봐요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %1$lld / %2$lld 天，明天见。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "第 %1$lld / %2$lld 天，明天見。"
          }
        }
      }
    },
    "%lld of %lld days. Today’s still to come.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%2$lld日中%1$lld日。今日の分はまだ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%2$lld일 중 %1$lld일. 오늘 것은 아직."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经 %1$lld / %2$lld 天，今天的还没放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已經 %1$lld / %2$lld 天，今天的還沒放。"
          }
        }
      }
    },
    "%lld of %lld paid films are yours": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "有料フィルム %2$lld本中 %1$lld本を所有"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "유료 필름 %2$lld개 중 %1$lld개 보유"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已拥有 %1$lld / %2$lld 卷付费胶卷"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已擁有 %1$lld / %2$lld 卷付費底片"
          }
        }
      }
    },
    "3 to 2": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "3対2"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "3대2"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3 比 2"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "3 比 2"
          }
        }
      }
    },
    "A click when you shoot": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "撮るときにカシャッと鳴ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "찍을 때 찰칵 소리가 납니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按快门时咔嚓一声"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "按快門時喀嚓一聲"
          }
        }
      }
    },
    "A day was missed: start again today. The pictures before stay.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1日空いたので今日からやり直し。前の写真はそのまま。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "하루 빠져서 오늘부터 다시. 이전 사진은 그대로예요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隔了一天，今天重新开始。前面的照片还在。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "隔了一天，今天重新開始。前面的照片還在。"
          }
        }
      }
    },
    "A light tap under your finger": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "指先に軽い手応え"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "손끝에 가벼운 진동"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指尖下轻轻一震"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "指尖下輕輕一震"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このアプリについて"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "정보"
          }
