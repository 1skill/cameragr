import Foundation

/// Where Koco's community lives: a Cloudflare Worker (user 11/24: the whole
/// backend on Cloudflare). Not deployed yet, so the app uses
/// `MockCommunityClient` until this is set. Nothing secret is ever here.
enum CommunityConfig {
    static let apiBase: URL? = nil
}
    func openMine() async {
        mineOpen = true
        let gen = generation
        let fresh = try? await client.me()
        guard gen == generation else { return }
        me = fresh
        keepRewards()
        await refreshNews()
        if let list = try? await client.mine(), gen == generation { mineList = list }
        await refreshFollows()
        newsShown = news
        if news.count > 0, (try? await client.markNewsSeen()) != nil { news = .none }
        if me?.isAdmin == true { await refreshModeration() }
    }

    func decideName(_ n: Community.NameRequest, approve: Bool) async {
        let gen = generation
        do {
            try await client.decideName(user: n.userId, version: n.version, approve: approve)
                .frame(width: r.width * 0.68, alignment: .leading)
                .offset(x: r.width * 0.28)
        }
        .frame(width: r.width, height: r.height)
        .offset(x: r.minX, y: r.minY)
        .accessibilityElement(children: .ignore)
        .accessibilityLabel(words)
    }

    // MARK: Mine

    private var envelope: some View {
        let r = Self.envelopeRect.scaled(s)
        let waiting = club.news.count + (club.me?.isAdmin == true ? club.queue.count + club.reported.count + club.modComments.count : 0)
        return Button {
            Haptic.click()
            Task { await club.openMine() }
        } label: {
            ZStack(alignment: .leading) {
                Image(uiImage: Self.envelope).resizable()
                Text("Mine").font(.custom("American Typewriter", size: 22 * s).weight(.semibold))
                    .foregroundStyle(KitArt.ink)
                    .padding(.leading, 24 * s)
            }
            .frame(width: r.width, height: r.height)
            .overlay(alignment: .topTrailing) {
                if waiting > 0 {
                    Text(verbatim: "\(waiting)")
                        .font(.system(size: 13 * s, weight: .bold)).foregroundStyle(.white)
                        .padding(.horizontal, 7 * s).padding(.vertical, 2 * s)
                        .background(Capsule().fill(Color(red: 0.72, green: 0.16, blue: 0.1)))
                        .offset(x: 4 * s, y: -6 * s)
                }
            }
            .contentShape(Rectangle())
        }
        .buttonStyle(.plain)
        .offset(x: r.minX, y: r.minY)

