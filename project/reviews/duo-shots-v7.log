diff --git a/project/BLUEPRINT.md b/project/BLUEPRINT.md
     1	"""App Store screenshots, sixth direction (project/discuss/shots-form.md):
     2	one warm-grey studio backdrop (GPT art) for the whole set, the headline at
     3	the top left, and one hero per page: a real app render shown big, bleeding
     4	off at least one edge, no insets. Regular iPhone portrait 1206x2622.
     5	  appstore_v6.py <zh|en> <out dir> <page ...>
     6	Renders: design/appstore/v6/src/<zh|en>/ (outer5.png = the outer screen @5x).
     7	"""
     8	import json, os, sys
     9	from PIL import Image, ImageDraw, ImageFilter, ImageFont
    10	
    11	W, H = 1206, 2622
    12	lang, out, pages = sys.argv[1], sys.argv[2], [int(p) for p in sys.argv[3:]] or [1]
    13	zh = lang.startswith("zh")
    14	SRC = f"design/appstore/v6/src/{'zh' if zh else 'en'}"
    15	COPY = json.load(open("design/appstore/v6/copy.json"))["zh" if zh else "en"]
    16	INK, SUB = (0x21, 0x1E, 0x18), (98, 90, 80)
    17	
    18	def font(size, bold=True):
    19	    if zh: return ImageFont.truetype("/System/Library/Fonts/Hiragino Sans GB.ttc", size, index=2 if bold else 0)   # 2 = W6 bold, 0 = W3
    20	    return ImageFont.truetype("/System/Library/Fonts/HelveticaNeue.ttc", size, index=1 if bold else 0)
    21	
    22	PAGE_COLOR = None   # a flat ground for the page being drawn (colour schemes A/B)
    23	
    24	def studio():
    25	    if PAGE_COLOR: return Image.new("RGB", (W, H), PAGE_COLOR)
    26	    bg = Image.open("design/appstore/v6/studio.png").convert("RGB")
    27	    s = max(W / bg.width, H / bg.height)
    28	    bg = bg.resize((round(bg.width * s), round(bg.height * s)), Image.LANCZOS)
    29	    return bg.crop(((bg.width - W) // 2, 0, (bg.width - W) // 2 + W, H))
    30	
    31	def headline(im, n):
    32	    """Left-aligned headline in up to two lines (broken by hand in copy.json
    33	    with \\n, never shrunk to fit), the same size on every page; an optional
    34	    subtitle below (project/discuss/shots-title.md)."""
    35	    head, line = COPY[str(n)]
    36	    d = ImageDraw.Draw(im)
    37	    x, top = 84, 150
    38	    size = 132 if zh else 112
    39	    step = 158 if zh else 136                     # baseline to baseline
    40	    f = font(size)
    41	    y = top
    42	    for row in head.split("\n"):
    43	        d.text((x, y), row, font=f, fill=INK, anchor="lt")
    44	        y += step
    45	    bottom = y - step + size
    46	    if line:
    47	        d.text((x, bottom + 36), line, font=font(52, False), fill=SUB, anchor="lt")
    48	        bottom += 36 + 52
    49	    return bottom
    50	
    51	def place(im, piece, xy, angle=0, radius=0, shadow=60):
    52	    """A real render on the backdrop: rounded, turned, with a soft studio shadow."""
    53	    piece = piece.convert("RGBA")
    54	    if radius:
    55	        m = Image.new("L", piece.size, 0)
    56	        ImageDraw.Draw(m).rounded_rectangle((0, 0, piece.width - 1, piece.height - 1), radius, fill=255)
    57	        piece.putalpha(m)
    58	    if angle: piece = piece.rotate(angle, expand=True, resample=Image.BICUBIC)
    59	    a = piece.split()[-1]
    60	    # Room around it for the blur to spread: a shadow blurred inside the
    61	    # piece's own box was cut off at the box and showed as a hard rectangle.
    62	    pad = shadow * 3
    63	    mask = Image.new("L", (piece.width + 2 * pad, piece.height + 2 * pad), 0)
    64	    mask.paste(a.point(lambda v: v * 0.45), (pad, pad))
    65	    mask = mask.filter(ImageFilter.GaussianBlur(shadow))
    66	    sh = Image.new("RGB", mask.size, (40, 30, 20))
    67	    x, y = xy
    68	    im.paste(sh, (x + shadow // 2 - pad, y + shadow - pad), mask)
    69	    im.paste(piece, (x, y), piece)
    70	
    71	def page1():
    72	    """A real film camera: the body huge, its LCD, red shutter, grille and
    73	    stripe filling the page; the left of the body runs off the edge."""
    74	    im = studio(); headline(im, 1)
    75	    body = Image.open(f"{SRC}/outer5.png").convert("RGB").rotate(90, expand=True)   # landscape body
    76	    h = 1900
    77	    body = body.resize((round(body.width * h / body.height), h), Image.LANCZOS)
    78	    turned = body.rotate(-3, expand=True)                                      # only to measure
    79	    place(im, body, (W - turned.width - 30, 560), angle=-3, radius=150, shadow=70)  # right edge inside
    80	    return im
    81	
    82	ROLLS = "cameragr/Resources/Rolls"
    83	ROLL_IDS = ["gold200", "portra400", "cine500t", "kodachrome64", "trix400", "instax", "c200", "ccd",
    84	            "velvia50", "fp100c", "grneg", "doublex", "vista100", "ektachrome", "natura1600", "pro400h"]
    85	SAMPLES = "design/appstore/iphone/src"
    86	
    87	def pattern(im, kind, top=0):
    88	    """Spaced, tiled rolls or small prints over the backdrop, a little turned
    89	    each, like things laid out on a studio table (app art, only placed)."""
    90	    import random
    91	    rnd = random.Random(7)
    92	    if kind == "rolls":
    93	        cell_w, cell_h, k = 300, 300, 0
    94	        for row, y in enumerate(range(top - 40, H + 200, cell_h)):
    95	            for col, x in enumerate(range(-60 + (row % 2) * cell_w // 2, W + 200, cell_w)):
    96	                roll = Image.open(f"{ROLLS}/roll_{ROLL_IDS[k % len(ROLL_IDS)]}.png").convert("RGBA"); k += 5
    97	                roll = roll.resize((round(roll.width * 190 / roll.height), 190), Image.LANCZOS)
    98	                place(im, roll, (x, y), angle=rnd.uniform(-25, 25), shadow=14)
    99	    else:
   100	        files = sorted(f for f in os.listdir(SAMPLES) if "__" in f and not f.startswith("orig"))
   101	        cell_w, cell_h, k = 330, 300, 0
   102	        for row, y in enumerate(range(top - 60, H + 200, cell_h)):
   103	            for col, x in enumerate(range(-80 + (row % 2) * cell_w // 2, W + 200, cell_w)):
   104	                ph = Image.open(f"{SAMPLES}/{files[k % len(files)]}").convert("RGB"); k += 7
   105	                ph = ph.resize((230, round(ph.height * 230 / ph.width)), Image.LANCZOS)
   106	                card = Image.new("RGB", (ph.width + 20, ph.height + 20), (240, 236, 228)); card.paste(ph, (10, 10))
   107	                place(im, card, (x, y), angle=rnd.uniform(-14, 14), shadow=16)
   108	
   109	def roll_img(k, h):
   110	    roll = Image.open(f"{ROLLS}/roll_{ROLL_IDS[k % len(ROLL_IDS)]}.png").convert("RGBA")
   111	    return roll.resize((round(roll.width * h / roll.height), h), Image.LANCZOS)
   112	
   113	def body_img(w):
   114	    body = Image.open(f"{SRC}/outer5.png").convert("RGB").rotate(90, expand=True)
   115	    return body.resize((w, round(body.height * w / body.width)), Image.LANCZOS)
   116	
   117	def calm_top(im, h=560):
   118	    im.paste(studio().crop((0, 0, W, h)), (0, 0))
   119	
   120	def page1_variant(v):
   121	    """Page 1 layouts with rolls (all app art, placed): v1 grid, v2 diagonal
   122	    rows, v3 one band behind the camera, v4 a pile poured round it, v5 on
   123	    the body's yellow."""
   124	    import random
   125	    rnd = random.Random(11)
   126	    im = studio()
   127	    if v == 5:
   128	        im = Image.new("RGB", (W, H), (236, 186, 52))
   129	    if v in (1, 5):
   130	        pattern(im, "rolls", top=0)
   131	    elif v == 2:
   132	        k = 0
   133	        for row, y in enumerate(range(-300, H + 300, 260)):
   134	            for col, x in enumerate(range(-400 + (row % 2) * 130, W + 300, 260)):
   135	                place(im, roll_img(k, 170), (x + row * 60, y), angle=-30, shadow=12); k += 3
   136	    elif v == 3:
   137	        k = 0
   138	        # two shelves of rolls standing upright: above and below the camera
   139	        for y in (790, 2010, 2300):
   140	            for x in range(-60 + (y // 7) % 70, W + 100, 150):
   141	                place(im, roll_img(k, 250), (x, y), angle=rnd.uniform(-3, 3), shadow=18); k += 3
   142	    elif v == 4:
   143	        k = 0
   144	        for _ in range(46):
   145	            x = rnd.uniform(-120, W - 60); y = rnd.uniform(900, H - 120)
   146	            place(im, roll_img(k, rnd.randint(180, 260)), (int(x), int(y)), angle=rnd.uniform(-80, 80), shadow=16); k += 1
   147	    if v != 5: calm_top(im)
   148	    else: im.paste(Image.new("RGB", (W, 560), (236, 186, 52)), (0, 0))
   149	    headline(im, 1)
   150	    body = body_img(1120)
   151	    place(im, body, ((W - body.width) // 2, 1180 if v != 4 else 760), radius=110, shadow=60)
   152	    return im
   153	
   154	def page2():
   155	    """Lots of films: a wall of prints, each from a different roll, its
   156	    canister pinned at the corner (real renders from the app, placed)."""
   157	    import random
   158	    rnd = random.Random(5)
   159	    im = studio(); headline(im, 2)
   160	    films = ["portra400", "cine500t", "trix400", "velvia50", "gold200", "natura1600", "fp100c", "ccd",
   161	             "kodachrome64", "doublex", "instax", "pro400h", "vista100", "ektachrome", "grneg", "c200"]
   162	    cols, pw = 3, 360
   163	    k = 0
   164	    used = set()
   165	    for row in range(5):
   166	        for col in range(cols):
   167	            fid = films[k % len(films)]; n = 1 + (k * 7) % 4; k += 1
   168	            # a scene not shown yet on this page (rolls share source pictures)
   169	            cands = sorted(f for f in os.listdir(SAMPLES) if f.startswith(fid + "__"))
   170	            pick = next((f for f in cands if f.split("__")[1] not in used), cands[0]); used.add(pick.split("__")[1])
   171	            ph = Image.open(f"{SAMPLES}/{pick}").convert("RGB")
   172	            ph = ph.resize((pw, round(ph.height * pw / ph.width)), Image.LANCZOS)
   173	            card = Image.new("RGBA", (ph.width + 24, ph.height + 24), (240, 236, 228, 255)); card.paste(ph, (12, 12))
   174	            x = 40 + col * (pw + 30) + (row % 2) * 30 - 15
   175	            y = 640 + row * 400
   176	            place(im, card, (x, y), angle=rnd.uniform(-5, 5), shadow=22)
   177	            roll = roll_img(ROLL_IDS.index(fid), 130)
   178	            place(im, roll, (x + card.width - 90, y + card.height - 110), angle=rnd.uniform(-20, 20), shadow=10)
   179	    return im
