    64	            let aside = url.deletingPathExtension().appendingPathExtension("unreadable-\(Int(Date().timeIntervalSince1970)).json")
    65	            writable = (try? FileManager.default.moveItem(at: url, to: aside)) != nil
    66	        }
    67	    }
    68	
