   151	        if next.timeZoneID == nil { next.timeZoneID = TimeZone.current.identifier }
   152	        let today = day(of: now(), in: next)
   153	        guard !next.entries.contains(where: { $0.asset == shot.asset && $0.day != today }) else { return false }
   154	        let replaced = next.entries.filter { $0.day == today && $0.asset != shot.asset }.map(\.asset)
   155	        next.entries.removeAll { $0.day == today }
   156	        next.entries.append(Entry(asset: shot.asset, film: shot.film, day: today, addedAt: now()))
   157	        let longest = run(in: next.entries).count
   158	        if longest > (next.bestRun ?? 0) { next.bestRun = longest }
   159	        if next.completedAt == nil {
   160	            let days = run(in: next.entries)
   161	            if days.count >= next.requiredDays {
   162	                next.completedDays = days.suffix(next.requiredDays).map(\.day)
   163	                next.completedAt = now()
   164	            }
   165	        }
   166	        guard save(next) else { return false }
   167	        // Today's picture replaced: its copy goes, unless another day has it.
   168	        for asset in replaced where !next.entries.contains(where: { $0.asset == asset }) { forget(asset) }
   169	        return true
   170	    }
   171	
   172	    /// Removes the book's copy of a picture the book doesn't hold (a copy
   173	    /// written for a picture that then couldn't be put in, or one replaced).
   174	    func forget(_ asset: String) {
   175	        guard !issue.entries.contains(where: { $0.asset == asset }) else { return }
   176	        try? FileManager.default.removeItem(at: keepsake(for: asset))
   177	        Self.cache.removeObject(forKey: asset as NSString)
   178	    }
   179	
   180	    /// Takes the roll the book earned. Someone who already has the film keeps
   181	    /// the book's stamp only; nothing else changes. Safe to repeat.
   182	    @discardableResult
   183	    func claim(store: FilmStore) -> Bool {
   184	        guard isComplete else { return false }
   185	        if isClaimed { return true }
   186	        if let film = FilmLibrary.shared.films.first(where: { $0.id == issue.rewardFilmID }), !store.isUnlocked(film) {
   187	            guard store.grant(film.id) else { return false }
   188	        }
   189	        var next = issue
   190	        next.claimedAt = now()
   191	        return save(next)
   192	    }
   193	
   194	    // MARK: Milestones
   195	
   196	    /// The longest run so far (the current one included).
   197	    var bestRun: Int { max(issue.bestRun ?? 0, run.count) }
   198	
   199	    /// The next limited roll still to take, once the issue's own roll is
   200	    /// taken; nil when there is none left.
   201	    var nextMilestone: (days: Int, filmID: String)? {
   202	        guard isClaimed else { return nil }
   203	        return Self.milestones.first { issue.milestonesClaimed?[$0.filmID] == nil }
   204	    }
   205	
   206	    /// The last milestone taken (shown once all are).
   207	    var lastMilestone: (days: Int, filmID: String)? {
   208	        Self.milestones.last { issue.milestonesClaimed?[$0.filmID] != nil }
   209	    }
   210	
   211	    /// The next limited roll not taken yet, whether or not the issue's own
   212	    /// roll is taken (for what the cover says).
   213	    var comingMilestone: (days: Int, filmID: String)? {
   214	        Self.milestones.first { issue.milestonesClaimed?[$0.filmID] == nil }
   215	    }
   216	
   217	    var canClaimMilestone: Bool { nextMilestone.map { bestRun >= $0.days } ?? false }
   218	
   219	    /// Takes the next limited roll once its days are reached. Safe to repeat.
   220	    @discardableResult
   221	    func claimMilestone(store: FilmStore) -> Bool {
   222	        guard let m = nextMilestone, bestRun >= m.days else { return false }
   223	        if let film = FilmLibrary.shared.films.first(where: { $0.id == m.filmID }), !store.isUnlocked(film) {
   224	            guard store.grant(film.id) else { return false }
   225	        }
   226	        var next = issue
   227	        var claimed = next.milestonesClaimed ?? [:]
   228	        claimed[m.filmID] = now()
   229	        next.milestonesClaimed = claimed
   230	        if (next.bestRun ?? 0) < bestRun { next.bestRun = bestRun }
   231	        return save(next)
   232	    }
   233	
   234	    // MARK: Keepsakes
   235	
   236	    /// The book keeps its own small copy of each picture put in, so deleting
   237	    /// it from Photos (or taking away access) doesn't empty the book.
   238	    private var keepsakes: URL { url.deletingLastPathComponent().appendingPathComponent("book", isDirectory: true) }
   239	
   240	    func keepsake(for asset: String) -> URL {
   241	        let name = asset.unicodeScalars.map { CharacterSet.alphanumerics.contains($0) ? String($0) : "_" }.joined()
   242	        return keepsakes.appendingPathComponent(name + ".jpg")
   243	    }
   244	
   245	    /// Pictures already read from the book's copies.
   246	    private static let cache = NSCache<NSString, UIImage>()
   247	
   248	    /// The book's copy of a picture, read off the main thread (and kept).
   249	    func keepsakeImage(for asset: String) async -> UIImage? {
   250	        if let known = Self.cache.object(forKey: asset as NSString) { return known }
   251	        let file = keepsake(for: asset)
   252	        let image = await Task.detached(priority: .userInitiated) { UIImage(contentsOfFile: file.path)?.preparingForDisplay() }.value
   253	        if let image { Self.cache.setObject(image, forKey: asset as NSString) }
   254	        return image
   255	    }
   256	
   257	    /// Writes the book's copy of a picture, encoding it off the main thread.
   258	    /// False if it couldn't be written.
   259	    func keep(_ image: UIImage, for asset: String) async -> Bool {
   260	        let folder = keepsakes, file = keepsake(for: asset)
   261	        let written = await Task.detached(priority: .userInitiated) { () -> Bool in
   262	            guard let data = image.jpegData(compressionQuality: 0.85) else { return false }
   263	            do {
   264	                try FileManager.default.createDirectory(at: folder, withIntermediateDirectories: true)
   265	                try data.write(to: file, options: .atomic)
   266	                return true
   267	            } catch {
   268	                return false
   269	            }
   270	        }.value
   271	        if written { Self.cache.setObject(image, forKey: asset as NSString) }
   272	        return written
   273	    }
   274	
   275	    private func save(_ next: Issue) -> Bool {
   276	        guard writable else { return false }
   277	        do {
   278	            try FileManager.default.createDirectory(at: url.deletingLastPathComponent(), withIntermediateDirectories: true)
   279	            try JSONEncoder().encode(next).write(to: url, options: .atomic)
   280	            issue = next
   281	            return true
   282	        } catch {
   283	            return false
   284	        }
   285	    }
   286	
   287	    #if DEBUG
   288	    /// `-bookDays N`: as if the last N days (ending today) each had a picture
   289	    /// put in, from the pictures Koco knows; with N ≥ 3 the book is complete.
   290	    func demo(days: Int, shots: [ShotLog.Shot]) {
   291	        guard days > 0 else { return }
   292	        var next = Self.first
   293	        next.timeZoneID = TimeZone.current.identifier
   294	        for back in (0..<days).reversed() {
   295	            let date = Calendar.current.date(byAdding: .day, value: -back, to: now()) ?? now()
   296	            let shot = shots.isEmpty ? nil : shots[back % shots.count]
   297	            var asset = shot?.asset ?? "none"
   298	            #if DEBUG
   299	            // `-bookPhotos /path/a.jpg,/path/b.jpg`: picture files instead of the
   300	            // phone's photos (store screenshots; the simulator reads the Mac's disk).
   301	            if let files = UserDefaults.standard.string(forKey: "bookPhotos")?.split(separator: ","), !files.isEmpty {
   302	                asset = "file:" + files[(days - 1 - back) % files.count]
   303	            }
   304	            #endif
   305	            next.entries.append(Entry(asset: asset, film: shot?.film ?? "gold200", day: day(of: date), addedAt: date))
   306	        }
   307	        if days >= next.requiredDays {
   308	            next.completedDays = next.entries.suffix(next.requiredDays).map(\.day)
   309	            next.completedAt = now()
   310	        }
   311	        next.bestRun = days
   312	        #if DEBUG
   313	        // `-bookClaimed 1`: the issue's own roll already taken (to see the next).
   314	        if UserDefaults.standard.bool(forKey: "bookClaimed") && next.completedAt != nil { next.claimedAt = now() }
   315	        #endif
   316	        issue = next
   317	    }
