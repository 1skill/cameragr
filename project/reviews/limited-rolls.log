    83	
    84	    private func day(of date: Date, in book: Issue) -> String {
    85	        var calendar = Calendar(identifier: .gregorian)
    86	        calendar.timeZone = book.timeZoneID.flatMap(TimeZone.init(identifier:)) ?? .current
    87	        let c = calendar.dateComponents([.year, .month, .day], from: date)
    88	        return String(format: "%04d-%02d-%02d", c.year ?? 0, c.month ?? 0, c.day ?? 0)
    89	    }
    90	
    91	    var today: String { day(of: now()) }
    92	
    93	    /// The day before `day`.
    94	    private func previous(_ day: String) -> String {
    95	        let parts = day.split(separator: "-").compactMap { Int($0) }
    96	        guard parts.count == 3,
    97	              let date = calendar.date(from: DateComponents(year: parts[0], month: parts[1], day: parts[2])),
    98	              let before = calendar.date(byAdding: .day, value: -1, to: date) else { return "" }
    99	        return self.day(of: before)
