  1473	  const since = new Date(clockNow() - NOTICE_DAYS * 86400000).toISOString();
  1474	  const seenRow = await env.DB.prepare('SELECT at FROM notice_seen WHERE user_id = ?').bind(me.id).first();
  1475	  const seenAt = seenRow ? seenRow.at : '';
