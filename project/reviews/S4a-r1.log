  1478	     JOIN posts p ON p.id = c.post_id JOIN users u ON u.id = c.author
  1479	     WHERE p.author = ? AND p.state = 'public' AND c.state = 'public' AND c.approved_at > ? AND ${ACTOR_OK('c.author')}
  1480	     ORDER BY c.approved_at DESC LIMIT 200`).bind(me.id, since, me.id, me.id, me.id).all()).results;
  1481	  const likeRows = (await env.DB.prepare(
  1482	    `SELECT l.post_id, l.user_id, l.created_at AS at, u.name FROM likes l
  1483	     JOIN posts p ON p.id = l.post_id JOIN users u ON u.id = l.user_id
  1484	     WHERE p.author = ? AND p.state = 'public' AND l.created_at > ? AND ${ACTOR_OK('l.user_id')}
  1485	     ORDER BY l.created_at DESC LIMIT 1000`).bind(me.id, since, me.id, me.id, me.id).all()).results;
  1486	  const followRows = (await env.DB.prepare(
  1487	    `SELECT f.follower, f.created_at AS at, u.name FROM follows f JOIN users u ON u.id = f.follower
  1488	     WHERE f.followee = ? AND f.created_at > ? AND ${ACTOR_OK('f.follower')}
  1489	     ORDER BY f.created_at DESC LIMIT 500`).bind(me.id, since, me.id, me.id, me.id).all()).results;
  1490	  const items = comments.map(c => ({ key: `c:${c.id}`, kind: 'comment', at: c.at, postId: c.post_id,
  1491	    people: [{ id: c.author, name: c.name }], count: 1, text: [...c.text].slice(0, 60).join('') }));
  1492	  // Rows come newest first: a group's time and its first names are its latest.
  1493	  const group = (rows, keyOf, make) => {
  1494	    const out = new Map();
  1495	    for (const r of rows) {
  1496	      const k = keyOf(r);
  1497	      if (!out.has(k)) out.set(k, make(r));
  1498	      const g = out.get(k);
  1499	      g.count += 1;
  1500	      if (g.people.length < 2) g.people.push({ id: r.who, name: r.name });
  1501	    }
  1502	    return [...out.values()];
  1503	  };
  1504	  items.push(...group(likeRows.map(r => ({ ...r, who: r.user_id })), r => r.post_id,
  1505	    r => ({ key: `l:${r.post_id}`, kind: 'likes', at: r.at, postId: r.post_id, people: [], count: 0 })));
  1506	  items.push(...group(followRows.map(r => ({ ...r, who: r.follower })), r => r.at.slice(0, 10),
  1507	    r => ({ key: `f:${r.at.slice(0, 10)}`, kind: 'follows', at: r.at, people: [], count: 0 })));
  1508	  items.sort((a, b) => (a.at === b.at ? (a.key < b.key ? 1 : -1) : (a.at < b.at ? 1 : -1)));
  1509	  const unread = Math.min(99, items.filter(i => i.at > seenAt).length);
  1510	  // Stable paging: older than the cursor's (time, key).
  1511	  const cur = url.searchParams.get('cursor');
  1512	  let rest = items;
  1513	  if (cur) {
  1514	    const [cAt, cKey] = [cur.slice(0, cur.indexOf('|')), cur.slice(cur.indexOf('|') + 1)];
  1515	    rest = items.filter(i => i.at < cAt || (i.at === cAt && i.key < cKey));
  1516	  }
  1517	  const page = rest.slice(0, NOTICE_PAGE);
  1518	  const last = page[page.length - 1];
  1519	  const out = await Promise.all(page.map(async i => ({ ...i, unread: i.at > seenAt,
  1520	    thumbURL: i.postId ? await photoLink(env, url, i.postId, 'thumb') : null })));
  1521	  return json({ notices: out, unread, nextCursor: rest.length > NOTICE_PAGE && last ? `${last.at}|${last.key}` : null });
  1522	}
