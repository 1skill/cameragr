  1524	/// Shown up to this time: the mark moves forward only, never back (a late,
  1525	/// older request can't undo a newer one), and never past now.
  1526	async function noticesSeen(request, env, me) {
  1527	  const b = await request.json().catch(() => ({}));
  1528	  const upTo = typeof b.upTo === 'string' ? b.upTo : '';
  1529	  if (!/^\d{4}-\d\d-\d\dT[\d:.]+Z$/.test(upTo) || isNaN(Date.parse(upTo))) fail(400, 'up-to');
  1530	  const at = upTo > nowISO() ? nowISO() : upTo;
  1531	  await env.DB.prepare(`INSERT INTO notice_seen (user_id, at) VALUES (?, ?)
  1532	    ON CONFLICT(user_id) DO UPDATE SET at = MAX(at, excluded.at)`).bind(me.id, at).run();
  1533	  return json(null, 204);
  1534	}
