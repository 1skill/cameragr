   753	    /// How much larger the writing is drawn at this scale (see `bagBoost`).
   754	    static func boost(_ s: CGFloat) -> CGFloat { Swift.min(1.6, Swift.max(1, 0.6 / s)) }
   755	
   756	    /// A page's board cut from its pair's picture and drawn only there (a
   757	    /// clipped picture of the whole bag would still take the other page's
   758	    /// touches).
   759	    static let boardRadius: CGFloat = 30
   760	    private static var boards: [String: UIImage] = [:]
   761	    private func halfPicture(_ picture: UIImage, left: Bool, s: CGFloat) -> some View {
   762	        let r = left ? Self.page : Self.lidPage
   763	        let key = "\(ObjectIdentifier(picture).hashValue)-\(left)"
   764	        let cut: UIImage
   765	        if let known = Self.boards[key] { cut = known } else {
   766	            let k = picture.scale
   767	            cut = picture.cgImage?.cropping(to: CGRect(x: r.minX * k, y: r.minY * k, width: r.width * k, height: r.height * k))
   768	                .map { UIImage(cgImage: $0) } ?? UIImage()
   769	            Self.boards[key] = cut
   770	        }
   771	        return Image(uiImage: cut).resizable()
   772	            .frame(width: r.width * s, height: r.height * s)
   773	            .offset(x: r.minX * s, y: r.minY * s)
   774	    }
   775	
   776	    /// The bag's case and spine round the two boards: always the films
   777	    /// pair's picture, above the lying pages and under a turning one.
   778	    private func bagCase(s: CGFloat) -> some View {
   779	        Image(uiImage: Self.bag).resizable()
   780	            .frame(width: Self.art.width * s, height: Self.art.height * s)
   781	            .mask {
   782	                Path { p in
   783	                    p.addRect(CGRect(x: 0, y: 0, width: Self.art.width * s, height: Self.art.height * s))
   784	                    p.addRoundedRect(in: Self.page.scaled(s), cornerSize: CGSize(width: Self.boardRadius * s, height: Self.boardRadius * s))
   785	                    p.addRoundedRect(in: Self.lidPage.scaled(s), cornerSize: CGSize(width: Self.boardRadius * s, height: Self.boardRadius * s))
   786	                }
   787	                .fill(style: FillStyle(eoFill: true))
   788	            }
   789	            .allowsHitTesting(false)
   790	            .accessibilityHidden(true)
   791	    }
