   793	    /// One page of a pair (its board), and where the turn puts it. Only the
   794	    /// inner board is a page: the case round it and the spine are one fixed
   795	    /// layer (`bagCase`), so nothing there changes or jumps. A board turns
   796	    /// about its own edge at the spine.
   797	    private func spreadPage(_ pair: Spread, left: Bool, s: CGFloat, @ViewBuilder content: () -> some View) -> some View {
   798	        let role = pageRole(pair, left: left)
   799	        let full = CGSize(width: Self.art.width * s, height: Self.art.height * s)
   800	        let board = (left ? Self.page : Self.lidPage).scaled(s)
   801	        let leaf = role == .leafOut || role == .leafIn
   802	        let hinge = UnitPoint(x: (left ? Self.page.maxX : Self.lidPage.minX) / Self.art.width, y: 0.5)
   803	        return ZStack(alignment: .topLeading) { content() }
   804	            .frame(width: full.width, height: full.height, alignment: .topLeading)
   805	            .modifier(PageTurn(progress: turn, role: role, left: left,
   806	                               cut: PageCut(rect: board, radius: Self.boardRadius * s), hinge: hinge))
   807	            .zIndex(leaf ? 2 : 0)
   808	            .allowsHitTesting(role == .still)
   809	            .accessibilityHidden(role != .still)
   810	    }
