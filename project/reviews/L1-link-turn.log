   824	    private func turnTo(_ pair: Spread) {
   825	        guard pair != spread, turnFrom == spread else { return }
   826	        Haptic.click()
   827	        if reduceMotion {
   828	            withAnimation(.easeInOut(duration: 0.15)) { turnFrom = pair; spread = pair }
   829	            return
   830	        }
   831	        turnFrom = spread
   832	        spread = pair
   833	        turn = 0
   834	        withAnimation(.timingCurve(0.42, 0, 0.3, 1, duration: 0.54)) { turn = 1 } completion: {
   835	            turnFrom = spread
   836	        }
   837	    }
