   812	    /// Turning forward, the right page goes over to the left: the old left
   813	    /// page stays until the turning board covers it, and the new right page
   814	    /// lies under the old one. Turning back is the mirror.
   815	    private func pageRole(_ pair: Spread, left: Bool) -> PageTurn.Role {
   816	        if turnFrom == spread { return pair == spread ? .still : .hidden }
   817	        let forward = spread.rawValue > turnFrom.rawValue
   818	        let turning = forward ? !left : left    // the board starts on this side
   819	        if pair == turnFrom { return turning ? .leafOut : .covered }
   820	        if pair == spread { return turning ? .revealed : .leafIn }
   821	        return .hidden
   822	    }
