   798	    func refreshModeration() async {
   799	        let gen = generation
   800	        do {
   801	            async let q = client.adminQueue()
   802	            async let r = client.adminReports()
   803	            async let a = client.adminAlerts()
   804	            async let h = client.adminHidden()
   805	            async let cw = client.adminComments("pending")
   806	            async let cr = client.adminComments("reported")
   807	            let (wait, reportedComments) = try await (cw, cr)
   808	            let lists = try await (q, r, a, h)
   809	            let status = try? await client.adminStatus()
   810	            let failed = (try? await client.adminFailedMail()) ?? []
   811	            let names = try? await client.adminNames()
   812	            let bios = try? await client.adminBios()
   813	            guard gen == generation else { return }
   814	            if let bios { bioRequests = bios }
   815	            (queue, reported, alerts, hiddenPosts) = lists
   816	            // A failed read keeps what was there (never "none waiting" by mistake).
   817	            if let names { nameRequests = names } else { note = Text("Names couldn’t be loaded. Pull to try again.") }
   818	            adminStatus = status
   819	            failedMail = failed
   820	            modComments = wait + reportedComments.filter { c in !wait.contains { $0.id == c.id } }
   821	        } catch {
   822	            Diag.note("club moderation failed: \(error)")
   823	            note = Text("Couldn’t load. Pull down to try again.")
   824	        }
   825	    }
