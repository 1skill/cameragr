  1460	
  1461	/// S4 notices, worked out when asked (no table of notices): others' public
  1462	/// comments on my public pictures, likes merged per picture (each person
  1463	/// once), new followers merged per day. Never one's own review or one's own
  1464	/// doings; nobody blocked either way, banned or leaving. Darkroom picks have no
  1465	/// real source yet, so the kind doesn't appear. The last 30 days, 30 a page.
  1466	/// Each kind is sorted and paged in the database, then the three are merged,
  1467	/// so nothing past a row limit is ever out of reach.
  1468	/// "Read" means shown: the app acknowledges each notice it showed (its key and
  1469	/// time); a group that grows later (a new like) is unread again. Nothing it
  1470	/// didn't show is marked.
  1471	const NOTICE_DAYS = 30, NOTICE_PAGE = 30;
  1472	const ACTOR_OK = (col) => `${col} != ? AND ${col} IN (SELECT id FROM users WHERE banned = 0 AND leaving_at IS NULL)
  1473	  AND ${col} NOT IN (SELECT blocked FROM blocks WHERE blocker = ?) AND ${col} NOT IN (SELECT blocker FROM blocks WHERE blocked = ?)`;
  1474	// Each kind as rows of (key, at, ...), newest first.
  1475	const NOTICE_SQL = {
  1476	  comment: `SELECT 'c:' || c.id AS key, c.approved_at AS at, c.post_id, c.text, c.author AS who, u.name, 1 AS n
  1477	    FROM comments c JOIN posts p ON p.id = c.post_id JOIN users u ON u.id = c.author
  1478	    WHERE p.author = ?1 AND p.state = 'public' AND c.state = 'public' AND c.approved_at > ?2
  1479	      AND ${ACTOR_OK('c.author').replace(/\?/g, '?1')}`,
  1480	  likes: `SELECT 'l:' || l.post_id AS key, MAX(l.created_at) AS at, l.post_id, NULL AS text, NULL AS who, NULL AS name, COUNT(*) AS n
  1481	    FROM likes l JOIN posts p ON p.id = l.post_id
  1482	    WHERE p.author = ?1 AND p.state = 'public' AND l.created_at > ?2 AND ${ACTOR_OK('l.user_id').replace(/\?/g, '?1')}
  1483	    GROUP BY l.post_id`,
  1484	  follows: `SELECT 'f:' || substr(f.created_at, 1, 10) AS key, MAX(f.created_at) AS at, NULL AS post_id, NULL AS text, NULL AS who, NULL AS name, COUNT(*) AS n
  1485	    FROM follows f WHERE f.followee = ?1 AND f.created_at > ?2 AND ${ACTOR_OK('f.follower').replace(/\?/g, '?1')}
  1486	    GROUP BY substr(f.created_at, 1, 10)`,
  1487	};
  1488	const UNREAD = `NOT EXISTS (SELECT 1 FROM notice_read r WHERE r.user_id = ?1 AND r.key = k.key AND r.at >= k.at)`;
  1489	
  1490	async function notices(env, url, me) {
  1491	  const since = new Date(clockNow() - NOTICE_DAYS * 86400000).toISOString();
  1492	  const cur = url.searchParams.get('cursor') || '';
  1493	  const bar = cur.indexOf('|');
  1494	  const cAt = bar > 0 ? cur.slice(0, bar) : '9999', cKey = bar > 0 ? cur.slice(bar + 1) : '\uffff';
  1495	  const older = `(k.at < ?3 OR (k.at = ?3 AND k.key < ?4))`;
  1496	  const kinds = Object.keys(NOTICE_SQL);
  1497	  const pages = await env.DB.batch([
  1498	    ...kinds.map(kind => env.DB.prepare(
  1499	      `SELECT k.*, ${UNREAD} AS unread FROM (${NOTICE_SQL[kind]}) k WHERE ${older} ORDER BY k.at DESC, k.key DESC LIMIT ${NOTICE_PAGE + 1}`
  1500	    ).bind(me.id, since, cAt, cKey)),
  1501	    env.DB.prepare(`SELECT COUNT(*) AS n FROM (${kinds.map(kind => `SELECT * FROM (${NOTICE_SQL[kind]})`).join(' UNION ALL ')}) k
  1502	      WHERE ${UNREAD} LIMIT 1`).bind(me.id, since),
  1503	  ]);
  1504	  const unreadTotal = Math.min(99, pages[kinds.length].results[0]?.n || 0);
  1505	  const merged = kinds.flatMap((kind, i) => pages[i].results.map(r => ({ kind, ...r })))
  1506	    .sort((a, b) => (a.at === b.at ? (a.key < b.key ? 1 : -1) : (a.at < b.at ? 1 : -1)));
  1507	  const page = merged.slice(0, NOTICE_PAGE);
  1508	  // The first two names of each group on this page (newest first).
  1509	  const likePosts = page.filter(i => i.kind === 'likes').map(i => i.post_id);
  1510	  const followDays = page.filter(i => i.kind === 'follows').map(i => i.key.slice(2));
  1511	  const names = new Map();
  1512	  const people = [];
  1513	  if (likePosts.length) people.push(env.DB.prepare(
  1514	    `SELECT 'l:' || post_id AS key, who, name FROM (SELECT l.post_id, l.user_id AS who, u.name,
  1515	       ROW_NUMBER() OVER (PARTITION BY l.post_id ORDER BY l.created_at DESC) AS rn
  1516	       FROM likes l JOIN users u ON u.id = l.user_id
  1517	       WHERE l.post_id IN (${likePosts.map(() => '?').join(',')}) AND l.created_at > ? AND ${ACTOR_OK('l.user_id')}) WHERE rn <= 2`
  1518	  ).bind(...likePosts, since, me.id, me.id, me.id));
  1519	  if (followDays.length) people.push(env.DB.prepare(
  1520	    `SELECT 'f:' || day AS key, who, name FROM (SELECT substr(f.created_at, 1, 10) AS day, f.follower AS who, u.name,
  1521	       ROW_NUMBER() OVER (PARTITION BY substr(f.created_at, 1, 10) ORDER BY f.created_at DESC) AS rn
  1522	       FROM follows f JOIN users u ON u.id = f.follower
  1523	       WHERE f.followee = ? AND substr(f.created_at, 1, 10) IN (${followDays.map(() => '?').join(',')}) AND f.created_at > ?
  1524	         AND ${ACTOR_OK('f.follower')}) WHERE rn <= 2`
  1525	  ).bind(me.id, ...followDays, since, me.id, me.id, me.id));
  1526	  if (people.length) for (const res of await env.DB.batch(people)) for (const r of res.results) {
  1527	    if (!names.has(r.key)) names.set(r.key, []);
  1528	    names.get(r.key).push({ id: r.who, name: r.name });
  1529	  }
  1530	  const out = await Promise.all(page.map(async i => ({
  1531	    key: i.key, kind: i.kind, at: i.at, count: i.n, unread: !!i.unread,
  1532	    postId: i.post_id || null, text: i.text ? [...i.text].slice(0, 60).join('') : null,
  1533	    people: i.kind === 'comment' ? [{ id: i.who, name: i.name }] : (names.get(i.key) || []),
  1534	    thumbURL: i.post_id ? await photoLink(env, url, i.post_id, 'thumb') : null })));
  1535	  const last = page[page.length - 1];
  1536	  return json({ notices: out, unread: unreadTotal,
  1537	                nextCursor: merged.length > NOTICE_PAGE && last ? `${last.at}|${last.key}` : null });
  1538	}
  1539	
  1540	/// The notices the app showed, each with the time it was shown at: those, and
  1541	/// only those, are read. At most a page at a time; old marks are swept.
  1542	async function noticesSeen(request, env, me) {
  1543	  const b = await request.json().catch(() => ({}));
  1544	  const shown = Array.isArray(b.shown) ? b.shown : [];
  1545	  if (!shown.length || shown.length > NOTICE_PAGE) fail(400, 'shown');
  1546	  const iso = /^\d{4}-\d\d-\d\dT[\d:.]+Z$/;
  1547	  for (const s_ of shown) if (typeof s_?.key !== 'string' || !/^[clf]:[\w.:-]{1,80}$/.test(s_.key) || !iso.test(s_.at || '')) fail(400, 'shown');
  1548	  const now = nowISO(), since = new Date(clockNow() - NOTICE_DAYS * 86400000).toISOString();
  1549	  await env.DB.batch([
  1550	    ...shown.map(s_ => env.DB.prepare(`INSERT INTO notice_read (user_id, key, at) VALUES (?, ?, ?)
  1551	      ON CONFLICT(user_id, key) DO UPDATE SET at = MAX(at, excluded.at)`).bind(me.id, s_.key, s_.at > now ? now : s_.at)),
  1552	    env.DB.prepare('DELETE FROM notice_read WHERE user_id = ? AND at < ?').bind(me.id, since),
  1553	  ]);
  1554	  return json(null, 204);
  1555	}
  1556	
  1557	// ---------------------------------------------------------------- pictures
  1558	
  1559	async function hmac(env, text) {
  1560	  if (!env.PHOTO_KEY) fail(503, 'photo-key');
  1561	  const key = await crypto.subtle.importKey('raw', enc.encode(env.PHOTO_KEY), { name: 'HMAC', hash: 'SHA-256' }, false, ['sign']);
  1562	  const sig = new Uint8Array(await crypto.subtle.sign('HMAC', key, enc.encode(text)));
  1563	  return btoa(String.fromCharCode(...sig)).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
  1564	}
  1565	
