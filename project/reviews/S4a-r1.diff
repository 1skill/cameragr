+/// S4 notices, worked out when asked (no table of notices): others' public
+/// comments on my public pictures, likes merged per picture (each person
+/// once), new followers merged per day. Never one's own review or one's own
+/// doings; nobody blocked either way, banned or leaving. Darkroom picks have no
+/// real source yet, so the kind doesn't appear. The last 30 days, 30 a page.
+/// "Read" means shown: the app says up to which time it showed, and the mark
+/// only moves forward.
+const NOTICE_DAYS = 30, NOTICE_PAGE = 30;
+const ACTOR_OK = (col) => `${col} != ? AND ${col} IN (SELECT id FROM users WHERE banned = 0 AND leaving_at IS NULL)
+  AND ${col} NOT IN (SELECT blocked FROM blocks WHERE blocker = ?) AND ${col} NOT IN (SELECT blocker FROM blocks WHERE blocked = ?)`;
+
+async function notices(env, url, me) {
+  const since = new Date(clockNow() - NOTICE_DAYS * 86400000).toISOString();
+  const seenRow = await env.DB.prepare('SELECT at FROM notice_seen WHERE user_id = ?').bind(me.id).first();
+  const seenAt = seenRow ? seenRow.at : '';
+  const comments = (await env.DB.prepare(
+    `SELECT c.id, c.post_id, c.text, c.approved_at AS at, c.author, u.name FROM comments c
+     JOIN posts p ON p.id = c.post_id JOIN users u ON u.id = c.author
+     WHERE p.author = ? AND p.state = 'public' AND c.state = 'public' AND c.approved_at > ? AND ${ACTOR_OK('c.author')}
+     ORDER BY c.approved_at DESC LIMIT 200`).bind(me.id, since, me.id, me.id, me.id).all()).results;
+  const likeRows = (await env.DB.prepare(
+    `SELECT l.post_id, l.user_id, l.created_at AS at, u.name FROM likes l
+     JOIN posts p ON p.id = l.post_id JOIN users u ON u.id = l.user_id
+     WHERE p.author = ? AND p.state = 'public' AND l.created_at > ? AND ${ACTOR_OK('l.user_id')}
+     ORDER BY l.created_at DESC LIMIT 1000`).bind(me.id, since, me.id, me.id, me.id).all()).results;
+  const followRows = (await env.DB.prepare(
+    `SELECT f.follower, f.created_at AS at, u.name FROM follows f JOIN users u ON u.id = f.follower
+     WHERE f.followee = ? AND f.created_at > ? AND ${ACTOR_OK('f.follower')}
+     ORDER BY f.created_at DESC LIMIT 500`).bind(me.id, since, me.id, me.id, me.id).all()).results;
+  const items = comments.map(c => ({ key: `c:${c.id}`, kind: 'comment', at: c.at, postId: c.post_id,
+    people: [{ id: c.author, name: c.name }], count: 1, text: [...c.text].slice(0, 60).join('') }));
+  // Rows come newest first: a group's time and its first names are its latest.
+  const group = (rows, keyOf, make) => {
+    const out = new Map();
+    for (const r of rows) {
+      const k = keyOf(r);
+      if (!out.has(k)) out.set(k, make(r));
+      const g = out.get(k);
+      g.count += 1;
+      if (g.people.length < 2) g.people.push({ id: r.who, name: r.name });
+    }
+    return [...out.values()];
+  };
+  items.push(...group(likeRows.map(r => ({ ...r, who: r.user_id })), r => r.post_id,
+    r => ({ key: `l:${r.post_id}`, kind: 'likes', at: r.at, postId: r.post_id, people: [], count: 0 })));
+  items.push(...group(followRows.map(r => ({ ...r, who: r.follower })), r => r.at.slice(0, 10),
+    r => ({ key: `f:${r.at.slice(0, 10)}`, kind: 'follows', at: r.at, people: [], count: 0 })));
+  items.sort((a, b) => (a.at === b.at ? (a.key < b.key ? 1 : -1) : (a.at < b.at ? 1 : -1)));
+  const unread = Math.min(99, items.filter(i => i.at > seenAt).length);
+  // Stable paging: older than the cursor's (time, key).
+  const cur = url.searchParams.get('cursor');
+  let rest = items;
+  if (cur) {
+    const [cAt, cKey] = [cur.slice(0, cur.indexOf('|')), cur.slice(cur.indexOf('|') + 1)];
+    rest = items.filter(i => i.at < cAt || (i.at === cAt && i.key < cKey));
+  }
+  const page = rest.slice(0, NOTICE_PAGE);
+  const last = page[page.length - 1];
+  const out = await Promise.all(page.map(async i => ({ ...i, unread: i.at > seenAt,
+    thumbURL: i.postId ? await photoLink(env, url, i.postId, 'thumb') : null })));
+  return json({ notices: out, unread, nextCursor: rest.length > NOTICE_PAGE && last ? `${last.at}|${last.key}` : null });
+}
+
+/// Shown up to this time: the mark moves forward only, never back (a late,
+/// older request can't undo a newer one), and never past now.
+async function noticesSeen(request, env, me) {
+  const b = await request.json().catch(() => ({}));
+  const upTo = typeof b.upTo === 'string' ? b.upTo : '';
+  if (!/^\d{4}-\d\d-\d\dT[\d:.]+Z$/.test(upTo) || isNaN(Date.parse(upTo))) fail(400, 'up-to');
+  const at = upTo > nowISO() ? nowISO() : upTo;
+  await env.DB.prepare(`INSERT INTO notice_seen (user_id, at) VALUES (?, ?)
+    ON CONFLICT(user_id) DO UPDATE SET at = MAX(at, excluded.at)`).bind(me.id, at).run();
+  return json(null, 204);
+}
