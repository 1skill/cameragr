   651	/// One's conversations: the other person, the last word, how many unread;
   652	/// only with people one may still write to or read (no blocks, bans, leaving).
   653	async function dmThreads(env, me) {
   654	  const rows = (await env.DB.prepare(
   655	    `SELECT t.*, u.name AS other_name FROM (
   656	       SELECT m.*, CASE WHEN m.sender = ?1 THEN m.recipient ELSE m.sender END AS other,
   657	              ROW_NUMBER() OVER (PARTITION BY m.pair ORDER BY m.rowid DESC) AS rn, m.rowid AS seq
   658	       FROM messages m WHERE m.sender = ?1 OR m.recipient = ?1) t
   659	     JOIN users u ON u.id = t.other
   660	     WHERE t.rn = 1 AND u.banned = 0 AND u.leaving_at IS NULL
   661	       AND NOT EXISTS (SELECT 1 FROM blocks WHERE (blocker = ?1 AND blocked = t.other) OR (blocker = t.other AND blocked = ?1))
   662	     ORDER BY t.seq DESC LIMIT 50`).bind(me.id).all()).results;
   663	  const unread = (await env.DB.prepare(
   664	    `SELECT sender, count(*) AS n FROM messages WHERE recipient = ? AND read_at IS NULL GROUP BY sender`).bind(me.id).all()).results;
   665	  const byOther = Object.fromEntries(unread.map(r => [r.sender, r.n]));
   666	  const threads = rows.map(r => ({ with: { id: r.other, name: r.other_name }, last: dmView(r, me), unread: byOther[r.other] || 0 }));
   667	  return json({ threads, unread: threads.reduce((n, t) => n + t.unread, 0) });
   668	}
