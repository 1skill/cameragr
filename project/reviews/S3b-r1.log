   442	/// A new account: Koco + digits in public; the name Apple gave, if it fits
   443	/// and is free, asked for like any other (shown to them, to others once approved).
   444	async function firstName(env, id, given) {
   445	  const fallback = 'Koco ' + id.slice(0, 6);
   446	  await claimName(env, id, nameKey(fallback), 'current');
   447	  await env.DB.prepare('UPDATE users SET name_norm = ? WHERE id = ?').bind(nameKey(fallback), id).run();
   448	  const name = given.replace(/\s+/g, ' ').trim();
   449	  let key = null;
   450	  try { key = checkName(name); } catch { key = null; }
   451	  if (key && await claimName(env, id, key, 'pending')) {
   452	    await env.DB.prepare('UPDATE users SET pending_name = ?, pending_at = ? WHERE id = ?').bind(name, nowISO(), id).run();
   453	  }
   454	}
   455	/// An account from before names were one to a person: its name is held now,
   456	/// or, if someone earlier holds it, it is asked to choose another.
   457	/// Who signed up first keeps it (retro S3): a later account that settled
   458	/// first, with the name it always had, gives it back and is asked to choose.
   459	async function settleName(env, user) {
   460	  if (user.name_norm || user.must_rename) return user;
   461	  const key = nameKey(user.name);
   462	  if (key && await claimName(env, user.id, key, 'current')) {
   463	    await env.DB.prepare('UPDATE users SET name_norm = ? WHERE id = ?').bind(key, user.id).run();
   464	    return { ...user, name_norm: key };
   465	  }
   466	  const holder = key ? await env.DB.prepare(
   467	    `SELECT u.id, u.created_at, u.name_changed_at, n.kind FROM names n JOIN users u ON u.id = n.user_id WHERE n.name_norm = ?`).bind(key).first() : null;
   468	  const earlier = holder && (user.created_at < holder.created_at || (user.created_at === holder.created_at && user.id < holder.id));
   469	  if (holder && earlier && holder.kind === 'current' && !holder.name_changed_at) {
   470	    const moved = await env.DB.batch([
   471	      env.DB.prepare('UPDATE names SET user_id = ?, created_at = ? WHERE name_norm = ? AND user_id = ?').bind(user.id, nowISO(), key, holder.id),
   472	      env.DB.prepare('UPDATE users SET name_norm = NULL, must_rename = 1 WHERE id = ? AND name_norm = ?').bind(holder.id, key),
   473	      env.DB.prepare('UPDATE users SET name_norm = ? WHERE id = ?').bind(key, user.id),
   474	    ]);
   475	    if (moved[0].meta.changes === 1) return { ...user, name_norm: key };
   476	  }
   477	  await env.DB.prepare('UPDATE users SET must_rename = 1 WHERE id = ?').bind(user.id).run();
   478	  return { ...user, must_rename: 1 };
   479	}
   480	/// Every account not yet settled, oldest first (run once after deploying S3,
   481	/// so a name is held for those who haven't signed in since).
   482	/// Ten at a time (a request may make at most 50 queries on the free plan):
   483	/// called again until `left` is 0.
   484	async function settleAllNames(env) {
   485	  const rows = (await env.DB.prepare('SELECT * FROM users WHERE name_norm IS NULL AND must_rename = 0 ORDER BY created_at, id LIMIT 10').all()).results;
   486	  for (const u of rows) await settleName(env, u);
   487	  const left = (await env.DB.prepare('SELECT count(*) AS n FROM users WHERE name_norm IS NULL AND must_rename = 0').first()).n;
   488	  return json({ settled: rows.length, left });
   489	}
   490	/// Asking for a new name: held for them at once (no one else can take it
   491	/// meanwhile), shown to them at once, to others once approved.
   492	async function requestName(request, env, me) {
   493	  const b = await request.json().catch(() => ({}));
   494	  const name = typeof b.name === 'string' ? b.name.replace(/\s+/g, ' ').trim() : '';
   495	  const key = checkName(name);
   496	  if (!me.must_rename && me.name_changed_at && clockNow() - Date.parse(me.name_changed_at) < NAME_DAYS * 86400_000) fail(429, 'too-soon');
   497	  await rateLimit(env, me, 'rename', 10, 86400);
   498	  const oldPending = me.pending_name ? nameKey(me.pending_name) : null;
   499	  if (key === me.name_norm) {
   500	    // Back to the name they have: whatever was asked for is let go.
   501	    if (oldPending) await env.DB.prepare("DELETE FROM names WHERE name_norm = ? AND user_id = ? AND kind = 'pending'").bind(oldPending, me.id).run();
   502	    await env.DB.prepare('UPDATE users SET pending_name = NULL, pending_at = NULL, shown_name = NULL WHERE id = ?').bind(me.id).run();
   503	    return json(await meView(env, { ...me, pending_name: null, shown_name: null }));
   504	  }
   505	  if (!await claimName(env, me.id, key, 'pending')) fail(409, 'taken');
   506	  // Only if nothing else changed their request meanwhile (two at once: one wins,
   507	  // the other's hold is let go).
   508	  const at = nowISO();
   509	  const set = await env.DB.prepare(
   510	    'UPDATE users SET pending_name = ?, pending_at = ?, shown_name = NULL WHERE id = ? AND pending_at IS ?').bind(name, at, me.id, me.pending_at ?? null).run();
   511	  if (set.meta.changes !== 1) {
   512	    if (key !== oldPending) await env.DB.prepare("DELETE FROM names WHERE name_norm = ? AND user_id = ? AND kind = 'pending'").bind(key, me.id).run();
   513	    fail(409, 'busy');
   514	  }
   515	  if (oldPending && oldPending !== key) {
   516	    await env.DB.prepare("DELETE FROM names WHERE name_norm = ? AND user_id = ? AND kind = 'pending'").bind(oldPending, me.id).run();
   517	  }
   518	  return json(await meView(env, { ...me, pending_name: name, pending_at: at }));
   519	}
   520	async function adminNames(env) {
   521	  const rows = (await env.DB.prepare(
   522	    'SELECT id, name, pending_name, pending_at FROM users WHERE pending_name IS NOT NULL ORDER BY pending_at LIMIT 100').all()).results;
   523	  return json({ names: rows.map(r => ({ userId: r.id, name: r.name, requested: r.pending_name, requestedAt: r.pending_at, version: r.pending_at })) });
   524	}
   525	async function decideName(request, env, admin, userId, decision) {
   526	  const b = await request.json().catch(() => ({}));
   527	  const u = await env.DB.prepare('SELECT * FROM users WHERE id = ?').bind(userId).first();
   528	  if (!u || !u.pending_name) fail(404, 'not-found');
   529	  // The request the admin saw, not one made since.
   530	  if (typeof b.version !== 'string' || b.version !== u.pending_at) fail(409, 'stale');
   531	  const key = nameKey(u.pending_name);
   532	  // Every step only if the request is still the one seen (one transaction:
   533	  // a new request in between leaves everything as it was, 409).
   534	  const still = 'EXISTS (SELECT 1 FROM users WHERE id = ? AND pending_at = ?)';
   535	  let steps;
   536	  if (decision === 'approve') {
   537	    steps = [
   538	      env.DB.prepare(`UPDATE names SET kind = 'current' WHERE name_norm = ? AND user_id = ? AND ${still}`).bind(key, userId, userId, b.version),
   539	      env.DB.prepare(`DELETE FROM names WHERE name_norm = ? AND user_id = ? AND ? != ? AND ${still}`)
   540	        .bind(u.name_norm || '', userId, u.name_norm || '', key, userId, b.version),
   541	      logStep(env, admin, 'name-approve', 'user', userId, u.pending_name),
   542	      // The 30 days count from when they asked, not from the approval; the
   543	      // first real name after the placeholder ("Koco xxxxxx") isn't a change.
   544	      env.DB.prepare(`UPDATE users SET name = pending_name, name_norm = ?,
   545	                      name_changed_at = CASE WHEN name = 'Koco ' || substr(id, 1, 6) THEN name_changed_at ELSE pending_at END,
   546	                      pending_name = NULL, pending_at = NULL, shown_name = NULL, must_rename = 0
   547	                      WHERE id = ? AND pending_at = ?`).bind(key, userId, b.version),
   548	    ];
   549	  } else {
   550	    // Turned down without a word to them (user 11/25): the name is let go.
   551	    steps = [
   552	      env.DB.prepare(`DELETE FROM names WHERE name_norm = ? AND user_id = ? AND kind = 'pending' AND ${still}`).bind(key, userId, userId, b.version),
   553	      logStep(env, admin, 'name-reject', 'user', userId, u.pending_name),
   554	      // They go on seeing it themselves; nothing starts the 30 days.
   555	      env.DB.prepare('UPDATE users SET shown_name = pending_name, pending_name = NULL, pending_at = NULL WHERE id = ? AND pending_at = ?').bind(userId, b.version),
   556	    ];
   557	  }
   558	  const done = await env.DB.batch(steps);
   559	  if (done[done.length - 1].meta.changes !== 1) fail(409, 'stale');   // nothing else applied either
   560	  return json(null, 204);
   561	}
