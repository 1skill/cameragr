+        switch n.kind {
+        case .comment, .likes:
+            if let id = n.postId { await open(postID: id) }
+        case .follows:
+            guard let who = n.people.first else { return }
+            mineOpen = false
+            await openAuthor(.init(id: who.id, name: who.name))
+        }
