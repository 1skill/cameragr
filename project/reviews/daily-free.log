// MARK: - Buying

/// Under a film's description: load it, try it, or buy it.
private struct PurchaseBar: View {
    @EnvironmentObject private var model: CameraModel
    @ObservedObject private var store = FilmStore.shared
    let film: Film
    let unit: CGFloat

    var body: some View {
        let unlocked = store.isUnlocked(film)
        let inUse = film == model.film
        VStack(alignment: .leading, spacing: 8 * unit) {
            if !unlocked, film.isLimited, let days = film.earnDays {
                // Never sold: only earned in the Book (no trials, no "all films").
                Text("Earn it in the Book · \(days) days →")
                    .font(.system(size: 12 * unit, weight: .medium))
                    .foregroundStyle(PanelStyle.accent)
            } else if !unlocked {
                let waiting = store.awaitingApproval.contains(FilmStore.productID(film))
                    || store.awaitingApproval.contains(FilmStore.allFilmsID)
                Text(waiting ? "Purchase waiting for approval"
                     : store.trialsLeft(film) > 0 ? "\(store.trialsLeft(film)) free trial shots left" : "Free trial shots used up")
                    .font(.system(size: 12 * unit))
                    .foregroundStyle(waiting ? PanelStyle.accent : PanelStyle.muted)
            }
            HStack(spacing: 8 * unit) {
                if !(unlocked && inUse) {
                    pill(unlocked ? "Load this roll" : (inUse ? "Trying" : "Try it"),
                         filled: unlocked, enabled: !inUse && (unlocked || store.trialsLeft(film) > 0)) {
                        load()
                    }
                } else {
                    pill("In use", filled: false, enabled: false) {}
                }
                if !unlocked, let price = store.price(film) {
                    pill(store.purchasing == FilmStore.productID(film) ? "…" : "Buy \(price)", filled: true,
                         enabled: store.purchasing == nil) {
                        Task { if await store.buy(film) { Haptic.stop() } }
                    }
                }
            }
            if !unlocked, !film.isLimited, store.price(film) == nil, store.productsUnavailable {
                // Offline, or the App Store out of reach: say so, and offer to try again.
                Button { Task { await store.loadProductsIfMissing(force: true) } } label: {
                    Text("Prices couldn't be loaded. Check the connection and tap to try again.")
                        .font(.system(size: 12 * unit, weight: .medium))
                        .foregroundStyle(PanelStyle.accent)
                        .multilineTextAlignment(.leading)
                        .fixedSize(horizontal: false, vertical: true)
                }
                .buttonStyle(.plain)
            }
            if !unlocked, !film.isLimited, !store.ownsAll, let all = store.allFilmsPrice {
                Button {
                    Task { if await store.buy(nil) { Haptic.stop() } }
                } label: {
                    Text("Or all films for \(all), new ones included")
        }
        .padding(14 * unit)
        .background(RoundedRectangle(cornerRadius: 14 * unit)
            .fill(LinearGradient(colors: [PanelStyle.accent.opacity(0.22), PanelStyle.card],
                                 startPoint: .leading, endPoint: .trailing)))
    }
}

private struct StoreCard: View {
    @EnvironmentObject private var model: CameraModel
    @ObservedObject private var store = FilmStore.shared
    let film: Film
    let unit: CGFloat

    var body: some View {
        let unlocked = store.isUnlocked(film)
        Button {
            model.panel = .detail(film)
            Haptic.tap()
        } label: {
            VStack(alignment: .leading, spacing: 8 * unit) {
                HStack(alignment: .top, spacing: 10 * unit) {
                    Canister(film: film).frame(width: 26 * unit, height: 52 * unit)
                    VStack(alignment: .leading, spacing: 2 * unit) {
                        Text(film.name)
                            .font(.system(size: 15 * unit, weight: .bold))
                            .foregroundStyle(PanelStyle.text)
                            .lineLimit(1).minimumScaleFactor(0.7)
                        Text(FilmNotes.all[film.id]?.tagline ?? "")
                            .font(.system(size: 11 * unit))
                            .foregroundStyle(PanelStyle.muted)
                            .lineLimit(2)
                            .fixedSize(horizontal: false, vertical: true)
                    }
                    Spacer(minLength: 0)
                    status(unlocked: unlocked)
                }
                HStack(spacing: 6 * unit) {
                    ForEach((FilmNotes.all[film.id]?.samples ?? []).prefix(3), id: \.file) { sample in
                        Thumbnail(film: film, sample: sample)
                            .aspectRatio(1.5, contentMode: .fit)
                            .clipShape(RoundedRectangle(cornerRadius: 5 * unit))
                    }
                }
            }
            .padding(12 * unit)
            .background(RoundedRectangle(cornerRadius: 14 * unit).fill(PanelStyle.card))
            .overlay(RoundedRectangle(cornerRadius: 14 * unit)
                .stroke(film == model.film ? PanelStyle.accent.opacity(0.7) : .clear, lineWidth: 1.5))
        }
        .buttonStyle(.plain)
        .accessibilityLabel(film.name)
    }

    @ViewBuilder
    private func status(unlocked: Bool) -> some View {
        if film == model.film && unlocked {
            tag("In use", filled: false)
        } else if unlocked {
            Button { use() } label: { tag("Use", filled: false) }.buttonStyle(.plain)
        } else if let price = store.price(film) {
            Button {
                Task { if await store.buy(film) { Haptic.stop() } }
            } label: { tag(store.purchasing == FilmStore.productID(film) ? "…" : LocalizedStringKey(price), filled: true) }
            .buttonStyle(.plain)
            .disabled(store.purchasing != nil)
        // a press of the volume or Camera Control button takes nothing.
        guard Posture.shared.mode != .flat else { return }
        // The bag open over the camera is the same: its clasp loads the roll,
        // not a press of a button.
        guard bag == nil else { return }
        // A shot during the loading animation, or before the chosen roll was
        // seen going in, is on the new roll.
        loadChosenRollNow()
        // No camera (access refused): say so again, and spend nothing.
        guard cameraReady else {
            Haptic.stop()
            message = Self.noCameraMessage
            return
        }
        // A paid film not bought yet: a few free shots, then its page.
        var isTrial = false
        if let film, !FilmStore.shared.isUnlocked(film) {
            guard FilmStore.shared.useTrial(film) else {
                Haptic.stop()
                // The LCD shows END and the finder offers the two ways on:
                // buy this roll there and then, or choose another (user, 11/23).
                // The shutter itself never leaves the camera.
                usedUp = film
                return
            }
            isTrial = true
        }
        isExposing = true
        Posture.shared.holdForShot(true)
        isReviewing = false
        releases += 1
        // Folded open, the finder lies flat under the eye and gravity says
        // nothing about it: the picture is kept exactly as the finder shows it.
        pendingShots.append(PendingShot(hold: Posture.shared.isOpen ? .up : hold.orientation,
                                        film: film, isTrial: isTrial, isSquare: isSquare))
        inFlight += 1
        Haptic.release()
        service.capture(flash: flash.mode, fast: fast)
    }

    // MARK: - Develop
        model.closeBag()
    }
    private func canShoot(_ roll: Film) -> Bool { store.isUnlocked(roll) || store.trialsLeft(roll) > 0 }

    /// The tag's one action: choose the roll as the next one (or take that
    /// back), or buy it when there is nothing left to try.
    private func useTag(_ roll: Film) {
        looking = roll
        lookingAll = false
        if roll == model.film, store.isUnlocked(roll) || store.trialsLeft(roll) > 0
            || store.awaitingApproval.contains(FilmStore.productID(roll)) { Haptic.click(); return }
        if roll == model.readyToLoad || store.isUnlocked(roll) || store.trialsLeft(roll) > 0 {
            model.chooseInLibrary(roll)
        } else if roll.isLimited {
            turnTo(.book)   // earned there, never sold
        } else if store.price(roll) != nil {
            // Bought is bought, not chosen: choosing stays a tap of its own.
            Task { if await store.buy(roll) { Haptic.stop() } }
        } else {
            Task { await store.loadProductsIfMissing(force: true) }
        }
    }
}

extension CGRect {
    func scaled(_ s: CGFloat) -> CGRect { CGRect(x: minX * s, y: minY * s, width: width * s, height: height * s) }
}

