import Foundation
import StoreKit

/// Buying films: StoreKit 2 non-consumables, one per paid film plus "all
/// films" (which also covers films added later). Free films need nothing.
/// Every paid film can be tried for a few shots before it is bought.
///
/// Until the products exist in App Store Connect, debug builds show
/// reference prices and a purchase simply unlocks the film on this phone,
/// so the whole flow can be tried; release builds never do that.
@MainActor
final class FilmStore: ObservableObject {
    static let shared = FilmStore()

    static let allFilmsID = "com.oneskill.cameragr.allfilms"
    static func productID(_ film: Film) -> String { "com.oneskill.cameragr.film.\(film.id)" }
    /// Free shots on a paid film before it has to be bought.
    static let trialShots = 3

    @Published private(set) var products: [String: Product] = [:]
    /// Product ids this Apple ID owns.
    @Published private(set) var owned: Set<String>
    @Published private(set) var purchasing: String?
    /// Purchases waiting for someone's approval (Ask to Buy, or a payment
    /// the bank still has to confirm). They complete later, through `Transaction.updates`.
    @Published private(set) var awaitingApproval: Set<String> = []
    @Published private(set) var trialsUsed: [String: Int]
    /// Films earned on this iPhone (the photo book), not bought: kept apart
    /// from purchases, so refreshing or restoring them never takes them away.
    @Published private(set) var gifted: Set<String>

    private let defaults = UserDefaults.standard
    private var updates: Task<Void, Never>?

    private init() {
        owned = Set(defaults.stringArray(forKey: "store.owned") ?? [])
        trialsUsed = defaults.dictionary(forKey: "store.trials") as? [String: Int] ?? [:]
        gifted = Set(defaults.stringArray(forKey: "store.gifted") ?? [])
        updates = Task { [weak self] in
            for await result in Transaction.updates {
                if case .verified(let transaction) = result {
                    await transaction.finish()
                    self?.awaitingApproval.remove(transaction.productID)
                    await self?.refreshEntitlements()
                }
            }
        }
        Task { await refresh() }
    }

    // MARK: State

    /// Can shoot it without trial shots: had for good, or today's free roll.
    func isUnlocked(_ film: Film) -> Bool { owns(film) || isFreeToday(film) }

    /// Had for good: free, bought, or earned.
    func owns(_ film: Film) -> Bool {
        // A limited roll is never bought (not with all films either): only earned.
        if film.isLimited { return gifted.contains(film.id) }
        return film.free == true || ownsAll || owned.contains(Self.productID(film)) || gifted.contains(film.id)
    }

    // MARK: The daily free roll

    /// One roll for sale is free to everyone for the day, as many shots as
    /// you like (user, 2026-11-24); the next day it is back to trial shots,
    /// the pictures stay. Worked out on the phone from the date, so every
    /// phone shows the same roll on the same day; limited rolls never take part.
    static var today: () -> Date = Date.init
    /// Tests that check purchases and trials turn the daily roll off.
    static var dailyFreeOn = true

    func dailyFree(on date: Date) -> Film? {
        guard Self.dailyFreeOn else { return nil }
        #if DEBUG
        // `-dailyFree off` (tests that count trial shots) or `-dailyFree <film id>` (checks, screenshots).
        if let pick = UserDefaults.standard.string(forKey: "dailyFree") {
            guard Calendar.current.isDate(date, inSameDayAs: Self.today()) else { return nil }
            return pick == "off" ? nil : FilmLibrary.shared.films.first { $0.id == pick && !$0.isLimited }
        }
        #endif
        let rota = FilmLibrary.shared.films.filter { $0.free != true && !$0.isLimited }.sorted { $0.id < $1.id }
        guard !rota.isEmpty else { return nil }
        var calendar = Calendar(identifier: .gregorian)
        calendar.timeZone = .current
        let c = calendar.dateComponents([.year, .month, .day], from: date)
        guard let day = calendar.date(from: c) else { return nil }
        let n = Int((day.timeIntervalSince1970 + Double(calendar.timeZone.secondsFromGMT(for: day))) / 86_400)
        // A fixed stride through the rota, so neighbouring days differ.
        let stride = rota.count % 5 == 0 ? 1 : 5
        return rota[(n * stride) % rota.count]
    }
    var dailyFreeToday: Film? { dailyFree(on: Self.today()) }
    var dailyFreeYesterday: Film? {
        dailyFree(on: Self.today().addingTimeInterval(-86_400))
    }
    func isFreeToday(_ film: Film) -> Bool { !film.isLimited && film.free != true && dailyFreeToday?.id == film.id }

    /// Gives a film earned in the app (see `BookStore`). False if it couldn't be kept.
    @discardableResult
    func grant(_ filmID: String) -> Bool {
        guard !isLockScreen else { return false }
        gifted.insert(filmID)
        defaults.set(Array(gifted).sorted(), forKey: "store.gifted")
        shareWithLockScreen()
        return defaults.stringArray(forKey: "store.gifted")?.contains(filmID) == true
    }
    var ownsAll: Bool { owned.contains(Self.allFilmsID) }
    var paidFilms: [Film] { FilmLibrary.shared.films.filter { $0.free != true && !$0.isLimited } }
    var ownedPaidCount: Int { paidFilms.filter(owns).count }

    func trialsLeft(_ film: Film) -> Int {
        isUnlocked(film) || film.isLimited ? 0 : max(0, Self.trialShots - (trialsUsed[film.id] ?? 0))
    }

    /// Takes one trial shot; false if none are left.
    func useTrial(_ film: Film) -> Bool {
        guard trialsLeft(film) > 0 else { return false }
        // On the Lock Screen the shot is noted for the app first; if it
        // cannot be noted, it is not given (the app would never count it).
        if isLockScreen {
            guard let log = Self.lockScreenTrialLog else { return false }
            let line = Data((film.id + "\n").utf8)
            do {
                if let handle = try? FileHandle(forWritingTo: log) {
                    try handle.seekToEnd(); try handle.write(contentsOf: line); try handle.close()
                } else {
                    try line.write(to: log)
                }
            } catch { return false }
        }
        trialsUsed[film.id, default: 0] += 1
        defaults.set(trialsUsed, forKey: "store.trials")
        shareWithLockScreen()
        return true
    }

    /// Gives back a trial shot that never became a picture (the camera or
    /// the developing failed). In the app only: on the Lock Screen the shot
    /// is already in the log the app counts, and stays spent.
    func returnTrial(_ film: Film) {
        guard !isLockScreen, let used = trialsUsed[film.id], used > 0 else { return }
        trialsUsed[film.id] = used - 1
        defaults.set(trialsUsed, forKey: "store.trials")
        shareWithLockScreen()
    }

    func price(_ film: Film) -> String? { film.isLimited ? nil : price(Self.productID(film)) }
    var allFilmsPrice: String? { price(Self.allFilmsID) }

    private func price(_ id: String) -> String? {
        if let product = products[id] { return product.displayPrice }
        #if DEBUG
        return id == Self.allFilmsID ? "¥68" : "¥12"   // reference prices until the products exist
        #else
        return nil
        #endif
    }

    // MARK: StoreKit

    func refresh() async {
        await loadProducts()
        // Works offline too: the system keeps the last known purchases.
        await refreshEntitlements()
    }

    /// The products (prices) could not be loaded: offline at launch, or the
    /// App Store out of reach. Bought films stay unlocked; buying waits.
    @Published private(set) var productsUnavailable = false
    private var lastProductLoad: Date?

    private var expectedProductIDs: [String] { [Self.allFilmsID] + paidFilms.map(Self.productID) }
    private var loadingProducts: Task<Void, Never>?

    /// One load at a time: a second call waits for the one under way.
    private func loadProducts() async {
        if let loadingProducts { return await loadingProducts.value }
        let task = Task { @MainActor in
            lastProductLoad = .now
            let missing = expectedProductIDs.filter { products[$0] == nil }
            if let list = try? await Product.products(for: missing) {
                for product in list { products[product.id] = product }   // kept, added to
            }
            // Any product still missing has no price: buying it waits for a retry.
            productsUnavailable = expectedProductIDs.contains { products[$0] == nil }
        }
        loadingProducts = task
        await task.value
        loadingProducts = nil
    }

    /// Tries again for any product still missing: when a page with prices
    /// opens, when the app comes back, or on a tap. At most every few seconds.
    func loadProductsIfMissing(force: Bool = false) async {
        guard productsUnavailable || products.isEmpty, !isLockScreen else { return }
        if !force, let last = lastProductLoad, Date.now.timeIntervalSince(last) < 5 { return }
        await loadProducts()
    }

    private func refreshEntitlements() async {
        if isLockScreen { await adoptAppContext(); return }
        var ids = Set<String>()
        for await result in Transaction.currentEntitlements {
            if case .verified(let transaction) = result, transaction.revocationDate == nil {
                ids.insert(transaction.productID)
            }
        }
        #if DEBUG
        ids.formUnion(defaults.stringArray(forKey: "store.debugOwned") ?? [])
        #endif
        owned = ids
        defaults.set(Array(ids), forKey: "store.owned")
        shareWithLockScreen()
    }

    // MARK: Lock Screen camera

    /// In the Lock Screen camera: the file in its session folder where trial
    /// shots are noted for the app (`lockScreenTrialLogName`).
    let s: CGFloat
    let use: () -> Void

    var body: some View {
        let r = RollLibrary.card.scaled(s)
        let note = FilmNotes.all[film.id]
        let ink = Color(red: 0.16, green: 0.13, blue: 0.10)
        VStack(alignment: .leading, spacing: 6 * s) {
            HStack(alignment: .firstTextBaseline) {
                Text(film.name).font(.custom("American Typewriter", size: 36 * s * b).weight(.semibold))
                Spacer(minLength: 8 * s)
                Text(verbatim: "ISO \(film.iso)").font(.custom("American Typewriter", size: 22 * s * b))
            }
            if let note {
                Text(note.tagline).font(.custom("American Typewriter", size: 22 * s * b).weight(.semibold))
                // Shown small, the card keeps its one line; the rest is for the big screen.
                if !b.isCompactBag {
                    Text(note.about).font(.custom("American Typewriter", size: 16 * s))
                        .lineLimit(showsBookHint ? 2 : 3).fixedSize(horizontal: false, vertical: true)
                }
            }
            // The roll the photo book gives: say so on its card.
            if showsBookHint {
                // Shorter and larger when the bag is small (outer screen).
                (b.isCompactBag ? Text("Or free: three days running in the Book")
                                : Text("Or free: put one a day in the Book, three days running."))
                    .font(.custom("American Typewriter", size: (b.isCompactBag ? 19 : 15) * s * b).weight(.semibold))
                    .foregroundStyle(Color(red: 0.72, green: 0.12, blue: 0.10).opacity(0.85))
            }
            Spacer(minLength: 0)
            Button(action: use) {
                action.font(.custom("Marker Felt", size: 25 * s * b))
                    .foregroundStyle(Color(red: 0.72, green: 0.12, blue: 0.10))
                    // A taller target without taking the card's room.
                    .contentShape(Rectangle().inset(by: -10))
            }
            .buttonStyle(.plain)
            // Free shots left: buying it outright is offered too, not only
            // once they are used up.
            if let price = buyOutright {
                Button {
                    Task { if await store.buy(film) { Haptic.stop() } }
                } label: {
                    Text("or buy it · \(price)")
                        .font(.custom("American Typewriter", size: 17 * s * b).weight(.semibold))
                        .underline()
                        // Kept apart from the line above, so a tap lands on one or the other.
                        .padding(.top, 4 * s)
                        .contentShape(Rectangle().inset(by: -4))
                }
                .buttonStyle(.plain)
                .disabled(store.purchasing != nil)
            }
        }
        .foregroundStyle(ink)
        .lineLimit(2).minimumScaleFactor(0.6)
        // Clear of the leather corners at the top; the last line of the card
        // is the sleeve's note (see PhotoSleeve).
        // Right of the well where the roll lies.
        .padding(.leading, 228 * s).padding(.trailing, 64 * s).padding(.top, 40 * s).padding(.bottom, 38 * s)
        .frame(width: r.width, height: r.height, alignment: .topLeading)
        .offset(x: r.minX, y: r.minY)
    }

    /// The roll the photo book gives, not had yet: its card says so.
    private var showsBookHint: Bool {
        #if DEBUG
        if UserDefaults.standard.bool(forKey: "bookHint") && film.id == BookStore.shared.issue.rewardFilmID { return true }
        #endif
        return film.id == BookStore.shared.issue.rewardFilmID && !store.isUnlocked(film) && !BookStore.shared.isClaimed
    }

    /// A limited roll not earned yet: how many days running it takes.
    private var earnDays: Int? { film.isLimited && !store.isUnlocked(film) ? film.earnDays : nil }

    /// The price to show under "Try it", for a film not bought that still
    /// has free shots (with none left, the action line itself is the price).
    private var buyOutright: String? {
        // Free today: buying it to keep is offered too.
        if store.isFreeToday(film), !store.owns(film),
           !store.awaitingApproval.contains(FilmStore.productID(film)) { return store.price(film) }
        guard !store.isUnlocked(film), store.trialsLeft(film) > 0,
              !store.awaitingApproval.contains(FilmStore.productID(film)) else { return nil }
        return store.price(film)
    }

    private var action: Text {
        // The roll in the camera with its free shots used: why the shutter
        // brought you here, and what to do.
        if store.awaitingApproval.contains(FilmStore.productID(film)) { return Text("Purchase waiting for approval") }
        if film == model.film, !store.isUnlocked(film), store.trialsLeft(film) == 0 {
            if let price = store.price(film) { return Text("Free shots used up · buy \(price) →") }
            return Text("Free shots used up · choose another roll")
        }
        if film == model.film { return Text("In the camera") }
        if film == model.readyToLoad {
            return model.bag != nil ? Text("Do up the bag’s clasp to load it · tap to undo")
                                    : Text("Close the phone to load it · tap to undo")
        }
        if store.awaitingApproval.contains(FilmStore.productID(film)) { return Text("Purchase waiting for approval") }
        if store.isFreeToday(film) && !store.owns(film) { return Text("Free today, as many shots as you like · load it →") }
        if store.isUnlocked(film) { return Text("Load this roll →") }
        if film == store.dailyFreeYesterday, store.trialsLeft(film) == 0, let price = store.price(film) { return Text("Yesterday’s free roll · keep it for \(price) →") }
        if let days = earnDays { return Text("Earn it in the Book · \(days) days →") }
        if store.trialsLeft(film) > 0 { return Text("Try it · \(store.trialsLeft(film)) free shots →") }
        if let price = store.price(film) { return Text("Buy \(price) →") }
        return Text("Prices couldn't be loaded. Check the connection and tap to try again.")
    }
}

/// A paper tag's writing, by hand.
private struct Tag: View {
    @Environment(\.bagBoost) private var boost
    enum Ink { case pencil, red, muted, price }
    let text: Text
    let ink: Ink
    let size: CGSize
    let action: () -> Void

    var body: some View {
        Button(action: action) {
            text
                // Shown small, the tag carries its state alone, written larger.
                .font(.custom("Marker Felt", size: size.width * 0.24))
                .foregroundStyle(color)
                .multilineTextAlignment(.center)
                .lineLimit(2).minimumScaleFactor(0.5)
                .padding(.horizontal, size.width * 0.06)
                .padding(.top, size.height * 0.28)        // under the tag's hole
                .frame(width: size.width, height: size.height)
                .rotationEffect(.degrees(-2))
        }
        .buttonStyle(.plain)
    }

    private var color: Color {
        switch ink {
        case .pencil: Color(red: 0.18, green: 0.17, blue: 0.16)
        case .red: Color(red: 0.72, green: 0.12, blue: 0.10)
        case .muted: Color(red: 0.42, green: 0.39, blue: 0.34)
        case .price: Color(red: 0.12, green: 0.25, blue: 0.55)
        }
    }
}

