     3	
     4	/// The day's theme, a nudge once a day (S6, user 11/25): a local notification
     5	/// on this iPhone, never from a server. Offered once one has posted; asked for
     6	/// only when chosen. It says "look at today's theme", never a theme's name
     7	/// (the next ones may not be known yet).
     8	@MainActor
     9	final class DailyReminder: ObservableObject {
    10	    static let shared = DailyReminder()
    11	    private static let id = "koco.daily-theme"
    12	    private let center = UNUserNotificationCenter.current()
    13	
    14	    /// On (chosen, and allowed by the system).
    15	    @Published private(set) var isOn = UserDefaults.standard.bool(forKey: "dailyReminderOn")
    16	    /// The offer stays until it's been answered once.
    17	    @Published private(set) var offered = UserDefaults.standard.bool(forKey: "dailyReminderOffered")
    18	    /// One has posted at least once on this iPhone: the offer can show.
    19	    @Published private(set) var hasPosted = UserDefaults.standard.bool(forKey: "clubPostedOnce")
    20	    /// The system said no: the switch points to Settings instead.
    21	    @Published private(set) var denied = false
    22	
    23	    /// At 19:00 in whatever time zone the phone is in (a calendar trigger
    24	    /// follows the phone's zone when it moves).
    25	    static let hour = 19
    26	
    27	    func notePosted() {
    28	        guard !hasPosted else { return }
    29	        hasPosted = true
    30	        UserDefaults.standard.set(true, forKey: "clubPostedOnce")
    31	    }
    32	
    33	    /// Bumped by every turn on or off: an older turning-on that ends late does nothing.
    34	    private var turn = 0
    35	
    36	    /// Chosen: ask the system (once), then set the daily nudge. Only once one
    37	    /// has posted (S6: never asked before).
    38	    func turnOn() async {
    39	        guard hasPosted else { return }
    40	        turn += 1
    41	        let mine = turn
    42	        offered = true
    43	        UserDefaults.standard.set(true, forKey: "dailyReminderOffered")
    44	        let granted = (try? await center.requestAuthorization(options: [.alert, .sound])) ?? false
    45	        guard mine == turn else { return }
    46	        guard granted else { denied = true; set(false); return }
    47	        denied = false
    48	        center.removePendingNotificationRequests(withIdentifiers: [Self.id])
    49	        let content = UNMutableNotificationContent()
    50	        content.title = String(localized: "Koco")
    51	        content.body = String(localized: "Look at today's theme.")
    52	        let trigger = UNCalendarNotificationTrigger(dateMatching: DateComponents(hour: Self.hour, minute: 0), repeats: true)
    53	        do {
    54	            try await center.add(UNNotificationRequest(identifier: Self.id, content: content, trigger: trigger))
    55	            guard mine == turn else { center.removePendingNotificationRequests(withIdentifiers: [Self.id]); return }
    56	            set(true)
    57	        } catch { if mine == turn { set(false) } }
    58	    }
    59	
    60	    /// Not wanted (now, or from the offer): nothing scheduled.
    61	    func turnOff(declined: Bool = false) {
    62	        turn += 1
    63	        if declined { offered = true; UserDefaults.standard.set(true, forKey: "dailyReminderOffered") }
    64	        center.removePendingNotificationRequests(withIdentifiers: [Self.id])
    65	        set(false)
    66	    }
    67	
    68	    /// The switch follows the system: turned off in Settings, it shows off.
