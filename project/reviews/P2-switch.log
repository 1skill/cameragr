     1	import Combine
     2	import AVFoundation
     3	import CoreImage
     4	import SwiftUI
     5	import UIKit
     6	
     7	/// App state: the loaded film, camera controls, and the capture → develop → save flow.
     8	@MainActor
     9	final class CameraModel: ObservableObject {
    10	    enum Flash: String, CaseIterable {
    11	        case off, auto, on
    12	
    13	        /// Spoken and shown name.
    14	        var title: String {
    15	            switch self {
    16	            case .off: String(ui: "Off")
    17	            case .auto: String(ui: "Auto")
    18	            case .on: String(ui: "On")
    19	            }
    20	        }
    21	
    22	        var mode: AVCaptureDevice.FlashMode {
    23	            switch self {
    24	            case .off: return .off
    25	            case .auto: return .auto
    26	            case .on: return .on
    27	            }
    28	        }
    29	
    30	        var next: Flash {
    31	            let all = Flash.allCases
    32	            return all[(all.firstIndex(of: self)! + 1) % all.count]
    33	        }
    34	    }
    35	
    36	    /// Frame aspect of the loaded film (135 film is 3:2).
    37	    nonisolated static let frameAspect: CGFloat = 3.0 / 2.0
    38	
    39	    let films: [Film] = FilmLibrary.shared.films
    40	    let frames = FrameStore()
    41	
    42	    @Published var film: Film? {
    43	        // Another roll in, by any way: the old one's "used up" note goes.
    44	        didSet { if film != oldValue { usedUp = nil } }
    45	    }
    46	    /// A roll chosen in the film library, loaded when the phone is next closed
    47	    /// (or folded for the waist-level finder). Looking through the library
    48	    /// alone never changes the loaded roll.
    49	    @Published private(set) var readyToLoad: Film?
    50	    /// The roll last looked at in the bag (on its card), not loaded yet.
    51	    var lookedAt: Film?
    52	    /// What goes in when the bag is put away (phone shut, turned upright to
    53	    /// shoot, clasp done up): the roll chosen with its tag, else the one
    54	    /// looked at last, if it can take a picture now.
    55	    private var rollToLoad: Film? {
    56	        if let readyToLoad { return readyToLoad }
    57	        guard let looked = lookedAt, looked != film else { return nil }
    58	        let store = FilmStore.shared
    59	        return store.isUnlocked(looked) || store.trialsLeft(looked) > 0 ? looked : nil
    60	    }
    61	    /// The chosen roll on its way into the camera after the phone was closed:
    62	    /// the chamber shows it going in (FilmChamber), then loads it.
    63	    @Published var arrivingRoll: Film?
    64	    /// The door is open on an empty chamber, the old roll already out: the
    65	    /// arriving roll only has to go in.
    66	    @Published var bayWaiting = false
    67	    /// Which arrival the fallback timer belongs to.
    68	    private var arrivalID: UUID?
    69	    /// The roll the next picture is taken on.
    70	    var nextShotFilm: Film? { arrivingRoll ?? film }
