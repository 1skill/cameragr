   180	/// Latest camera frame and selected film, shared between the capture queue and the view.
   181	final class FrameStore {
   182	    private let lock = NSLock()
   183	    private var image: CIImage?
   184	    private var iso: Float = 100
   185	    private var film: Film?
   186	    /// Counts camera frames, so a redraw of the same frame can be told apart.
   187	    private(set) var sequence = 0
   188	
   189	    func set(image: CIImage, iso: Float) {
