   191	    }
   192	
   193	    func currentSequence() -> Int {
   194	        lock.lock(); defer { lock.unlock() }
   195	        return sequence
   196	    }
   197	
   198	    func set(film: Film?) {
   199	        lock.lock(); self.film = film; lock.unlock()
   200	    }
   201	
   202	    func snapshot() -> (image: CIImage?, film: Film?, iso: Float) {
   203	        lock.lock()
   204	        defer { lock.unlock() }
